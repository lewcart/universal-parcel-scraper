{
  "id": "a1-post",
  "displayName": "A1 POST",
  "aliases": [
    "A1 Post",
    "A1Post",
    "А1 Трейд ЕООД"
  ],
  "region": {
    "countries": [
      "BG"
    ]
  },
  "brand": {
    "color": "#fba512"
  },
  "selectable": true,
  "timezone": "Europe/Sofia",
  "tracking": {
    "mode": "automatic",
    "adapter": "a1-post",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "offset_timestamps",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://a1post.bg/track.php?t={trackingNumber}",
    "searchUrl": "https://a1post.bg/en/track/",
    "canaryUrl": "https://a1post.bg/en/track/",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "delivered_at",
      "weight",
      "service_name",
      "provider_code",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "a1post.bg",
        "www.a1post.bg"
      ],
      "pathPattern": "^/track\\.php$",
      "params": [
        "t"
      ]
    }
  ],
  "detection": []
}
