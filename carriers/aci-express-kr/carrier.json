{
  "id": "aci-express-kr",
  "displayName": "ACI Express",
  "aliases": [
    "ACI WORLDWIDE",
    "에이씨아이월드와이드",
    "ACIEXPRESS"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#db2e6e"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "aci-express-kr",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 684
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.acieshop.com/pod.php?OrderNo={trackingNumber}",
    "searchUrl": "https://www.aciexpress.net/delivery/",
    "canaryUrl": "https://www.aciexpress.net/delivery/",
    "shows": [
      "status",
      "history",
      "location",
      "recipient_name",
      "delivery_partner",
      "delivery_tracking_number",
      "driver_name",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "recipient_name",
      "driver_name",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "delivered_at",
      "offset_timestamps",
      "weight",
      "service_name",
      "origin_country",
      "destination_country",
      "sender_name",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "acieshop.com",
        "www.acieshop.com"
      ],
      "pathPattern": "^/aci_pod/pod\\.php$",
      "params": [
        "BL"
      ]
    },
    {
      "domains": [
        "acieshop.com",
        "www.acieshop.com"
      ],
      "pathPattern": "^/pod\\.php$",
      "params": [
        "OrderNo"
      ]
    },
    {
      "domains": [
        "acieshop.com",
        "www.acieshop.com",
        "old.acieshop.com"
      ],
      "pathPattern": "^/pod\\.html$",
      "params": [
        "OrderNo"
      ]
    },
    {
      "domains": [
        "acieshop.com",
        "www.acieshop.com"
      ],
      "pathPattern": "^/trackingbl\\.html$",
      "params": [
        "bl"
      ]
    },
    {
      "domains": [
        "pod.acieshop.com"
      ],
      "pathPattern": "^/tracking\\.php$",
      "params": [
        "bl"
      ]
    },
    {
      "domains": [
        "wms.acieshop.com"
      ],
      "path": "^/comn/deliveryTrack/(\\d+)/?$"
    },
    {
      "domains": [
        "133.acieshop.com"
      ],
      "pathPattern": "^/webpod\\.php$",
      "params": [
        "HawbNo"
      ]
    }
  ],
  "detection": []
}
