{
  "id": "acs-courier",
  "displayName": "ACS Courier",
  "aliases": [
    "ACS",
    "ACS Courier S.A."
  ],
  "region": {
    "countries": [
      "GR",
      "CY"
    ]
  },
  "brand": {
    "color": "#e42229"
  },
  "selectable": true,
  "timezone": "Europe/Athens",
  "tracking": {
    "mode": "automatic",
    "adapter": "acs-courier",
    "steps": [
      "direct",
      "refresh"
    ],
    "recognition": {
      "rank": 57
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "pickup_point"
  ],
  "portal": {
    "url": "https://cyp.acscourier.net/en/quick-access/non-registered-users/track-and-trace/?trackingNumber={trackingNumber}",
    "searchUrl": "https://cyp.acscourier.net/en/quick-access/non-registered-users/track-and-trace/",
    "canaryUrl": "https://cyp.acscourier.net/en/quick-access/non-registered-users/track-and-trace/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "pickup_point",
      "progress_rail",
      "recipient_name",
      "signatory",
      "sender_name",
      "delivery_comments",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "pickup_point"
    ],
    "discarded": [
      "delivered_at",
      "progress_rail",
      "recipient_name",
      "signatory",
      "sender_name",
      "delivery_comments",
      "office_contact_details"
    ],
    "unavailable": [
      "offset_timestamps",
      "weight",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "acscourier.net"
      ],
      "pathPattern": "^/(?:(?:el|en)/)?grigori-prosvasi/mi-eggegrammenoi-xristes/anazitisi-apostolwn/?$",
      "params": [
        "trackingNumber"
      ]
    },
    {
      "domains": [
        "acscourier.net"
      ],
      "pathPattern": "^/en/quick-access/non-registered-users/track-and-trace/?$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": []
}
