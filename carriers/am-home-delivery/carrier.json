{
  "id": "am-home-delivery",
  "displayName": "AM Home Delivery",
  "aliases": [],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#013e81"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "am-home-delivery",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 626
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "eta_window"
  ],
  "portal": {
    "url": "https://www.amtrucking.com/track-number.php?cnumber={trackingNumber}",
    "searchUrl": "https://www.amtrucking.com/tracking.php",
    "canaryUrl": "https://www.amtrucking.com/tracking.php",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "eta",
      "eta_window",
      "customer_reference",
      "awb_date",
      "order_contents",
      "recipient_address",
      "postcodes",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "progress_rail",
      "history",
      "location",
      "eta",
      "eta_window"
    ],
    "discarded": [
      "customer_reference",
      "awb_date",
      "order_contents",
      "recipient_address",
      "postcodes",
      "office_contact_details"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code",
      "service_name",
      "weight",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.amtrucking.com",
        "amtrucking.com"
      ],
      "pathPattern": "^/track-number\\.php$",
      "params": [
        "cnumber"
      ]
    },
    {
      "domains": [
        "tracking.carrierlogistics.com"
      ],
      "pathPattern": "^/scripts/amh\\.pol/boldetail\\.htm$",
      "params": [
        "wpro1"
      ]
    }
  ],
  "detection": []
}
