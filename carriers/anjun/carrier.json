{
  "id": "anjun",
  "displayName": "Anjun Logistics",
  "aliases": [
    "Anjun",
    "AnJun",
    "SZ Anjun",
    "Shenzhen Anjun Logistics",
    "安骏物流",
    "深圳市安骏物流有限公司",
    "Anjun Express"
  ],
  "region": {
    "countries": [
      "CN",
      "BR"
    ]
  },
  "brand": {
    "color": "#009944"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "anjun",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 954
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country"
  ],
  "portal": {
    "url": "https://anjuntrack.com/trackQuery?t={trackingNumber}",
    "searchUrl": "https://anjuntrack.com/trajectory",
    "canaryUrl": "https://anjuntrack.com/trajectory",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail",
      "destination_country",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "failed_delivery_reason",
      "destination_country"
    ],
    "discarded": [
      "progress_rail",
      "recipient_address"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "anjuntrack.com",
        "pu.anjuntrack.com"
      ],
      "pathPattern": "^/trackQuery/?$",
      "params": [
        "t"
      ],
      "ownNumbersOnly": true
    },
    {
      "domains": [
        "anjuntrack.com",
        "pu.anjuntrack.com"
      ],
      "pathPattern": "^/trajectory/?$",
      "params": [
        "orderNum"
      ],
      "ownNumbersOnly": true
    },
    {
      "domains": [
        "anjunexpress.com"
      ],
      "pathPattern": "^/trackPackage/?$",
      "params": [
        "tracking"
      ],
      "ownNumbersOnly": true
    }
  ],
  "detection": [
    {
      "id": "anjun-aj",
      "pattern": "^AJ\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{9}$",
      "confidence": "high"
    }
  ]
}
