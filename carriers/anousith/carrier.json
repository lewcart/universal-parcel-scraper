{
  "id": "anousith",
  "displayName": "Anousith Logistics",
  "aliases": [
    "Anousith Express",
    "Anousith",
    "ອານຸສິດ ໂລຈິສຕິກ",
    "ອານຸສິດ ເອັກສເພຮດ"
  ],
  "region": {
    "countries": [
      "LA"
    ]
  },
  "brand": {
    "color": "#e0353a"
  },
  "selectable": true,
  "timezone": "Asia/Vientiane",
  "tracking": {
    "mode": "automatic",
    "adapter": "anousith",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 649
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivered_at",
    "weight",
    "pickup_point"
  ],
  "portal": {
    "url": "https://app.anousith.express/landing/search_tracking/search_item?_bill_detail={trackingNumber}&n_home=2",
    "searchUrl": "https://app.anousith.express/landing/search_tracking/search_item",
    "canaryUrl": "https://app.anousith.express/landing/search_tracking/search_item",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at",
      "origin",
      "destination",
      "weight",
      "dimensions",
      "sender_name",
      "recipient_name",
      "recipient_contact",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at",
      "weight",
      "provider_code",
      "pickup_point"
    ],
    "discarded": [
      "origin",
      "destination",
      "dimensions",
      "sender_name",
      "recipient_name",
      "recipient_contact",
      "payment_details"
    ],
    "unavailable": [
      "eta",
      "service_name",
      "proof_of_delivery",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "app.anousith.express"
      ],
      "pathPattern": "^/landing/search_tracking/search_item/?$",
      "params": [
        "_bill_detail"
      ]
    },
    {
      "domains": [
        "app.anousith.express"
      ],
      "pathPattern": "^/landing/search_tracking/bill_share/?$",
      "params": [
        "tacking_number"
      ]
    }
  ],
  "detection": []
}
