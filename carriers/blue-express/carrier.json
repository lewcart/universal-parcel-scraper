{
  "id": "blue-express",
  "displayName": "Blue Express",
  "aliases": [
    "BlueExpress",
    "Bluex",
    "Blue Express Chile"
  ],
  "region": {
    "countries": [
      "CL"
    ]
  },
  "brand": {
    "color": "#0032a0"
  },
  "selectable": true,
  "timezone": "America/Santiago",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
  "portal": {
    "url": "https://www.blue.cl/enviar/seguimiento?n_seguimiento={trackingNumber}",
    "searchUrl": "https://www.blue.cl/",
    "canaryUrl": "https://www.blue.cl/",
    "shows": [],
    "scraped": [],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "blue.cl"
      ],
      "pathPattern": "^/(?:enviar|emprendedores)/seguimiento/?$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "blue.cl",
        "bluex.cl"
      ],
      "pathPattern": "^/seguimiento/?$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "tracking-unificado.blue.cl"
      ],
      "pathPattern": "^/$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "tracking.bluex.cl"
      ],
      "pathPattern": "^/lctracking\\.asp$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
