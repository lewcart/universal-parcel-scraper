{
  "id": "blue-express",
  "displayName": "Blue Express",
  "aliases": [
    "BlueExpress",
    "Bluex",
    "Blue Express Chile"
  ],
  "region": {
    "countries": [
      "CL"
    ]
  },
  "brand": {
    "color": "#0032a0"
  },
  "selectable": true,
  "timezone": "America/Santiago",
  "tracking": {
    "mode": "automatic",
    "adapter": "blue-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 971
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.blue.cl/enviar/seguimiento?n_seguimiento={trackingNumber}",
    "searchUrl": "https://www.blue.cl/",
    "canaryUrl": "https://www.blue.cl/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "progress_rail",
      "sender_name",
      "receiver_name",
      "origin",
      "destination",
      "pickup_point",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "eta",
      "progress_rail",
      "sender_name",
      "receiver_name",
      "origin",
      "destination",
      "pickup_point",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "blue.cl"
      ],
      "pathPattern": "^/(?:enviar|emprendedores)/seguimiento/?$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "blue.cl",
        "bluex.cl"
      ],
      "pathPattern": "^/seguimiento/?$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "tracking-unificado.blue.cl"
      ],
      "pathPattern": "^/$",
      "params": [
        "n_seguimiento"
      ]
    },
    {
      "domains": [
        "tracking.bluex.cl"
      ],
      "pathPattern": "^/lctracking\\.asp$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
