    "searchUrl": "https://www.bombinoexp.com/track",
    "canaryUrl": "https://www.bombinoexp.com/track",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "origin",
      "destination",
      "destination_country",
      "recipient_name",
      "signatory",
      "remarks",
      "delivery_tracking_number",
      "delivery_partner",
      "parcel_scans"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "origin",
      "destination",
      "recipient_name",
      "signatory",
      "remarks",
      "parcel_scans"
    ],
    "unavailable": [
