    },
    {
      "domains": [
        "www.bombinoexp.com",
        "bombinoexp.com"
      ],
      "pathPattern": "^/Tracking\\.aspx$",
      "params": [
        "txtAwb"
      ]
    },
    {
      "domains": [
        "www.bombinoexp.com",
        "bombinoexp.com"
      ],
