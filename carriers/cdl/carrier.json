{
  "id": "cdl",
  "displayName": "CDL Last Mile",
  "aliases": [
    "CDL",
    "CDL Last Mile Solutions",
    "CDL Delivers"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#3d74b2"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
  "portal": {
    "url": "https://apps.cdldelivers.com/Tracking-Page/track?id={trackingNumber}",
