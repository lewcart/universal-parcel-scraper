{
  "id": "ceva-logistics",
  "displayName": "CEVA Logistics",
  "aliases": [
    "CEVA",
    "CEVA Trak",
    "CEVA Home Delivery"
  ],
  "region": {
    "countries": [
      "FR"
    ]
  },
  "brand": {
    "color": "#1d2546"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "ceva-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 925
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "location",
    "eta",
    "weight",
    "destination_country",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://www.cevalogistics.com/en/ceva-trak?reference_query={trackingNumber}",
    "searchUrl": "https://www.cevalogistics.com/en/ceva-trak",
    "canaryUrl": "https://my.cevalogistics.com/follow",
    "shows": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "eta_window",
      "weight",
      "volume",
      "dimensions",
      "parcel_count",
      "origin",
      "destination",
      "destination_country",
      "references",
      "additional_services",
      "payment_details",
      "delivered_at",
      "canonical_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "weight",
      "destination_country",
      "canonical_tracking_number"
    ],
    "discarded": [
      "eta_window",
      "volume",
      "dimensions",
      "parcel_count",
      "origin",
      "destination",
      "references",
      "additional_services",
      "payment_details",
      "delivered_at"
    ],
    "unavailable": [
      "offset_timestamps",
      "signatory",
      "proof_of_delivery",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "cevalogistics.com"
      ],
      "pathPattern": "^/[a-z]{2}(?:-[a-z]+)?/ceva-trak/?$",
      "params": [
        "reference_query"
      ]
    },
    {
      "domains": [
        "homedelivery.cevalogistics.com"
      ],
      "pathPattern": "^/Track(?:\\.aspx)?/?$",
      "params": [
        "trackingID"
      ]
    },
    {
      "domains": [
        "etracking.cevalogistics.com"
      ],
      "pathPattern": "^/eTrackResultsMulti\\.aspx$",
      "params": [
        "sv"
      ]
    }
  ],
  "detection": []
}
