      "destination",
      "customer_reference",
      "item_category",
      "parcel_count",
      "related_tracking_numbers",
      "driver_name",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "weight"
    ],
    "discarded": [
      "progress_rail",
      "origin",
      "destination",
      "customer_reference",
      "item_category",
      "parcel_count",
      "related_tracking_numbers",
      "driver_name",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
