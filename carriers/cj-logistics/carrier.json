{
  "id": "cj-logistics",
  "displayName": "CJ Logistics",
  "aliases": [
    "CJ대한통운",
    "CJ Korea Express",
    "CJ Daehan Tongun",
    "CJ GLS",
    "대한통운"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#ef151e"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "cj-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 977
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://www.cjlogistics.com/ko/tool/parcel/newTracking?gnbInvcNo={trackingNumber}",
    "searchUrl": "https://www.cjlogistics.com/ko/tool/parcel/tracking",
    "canaryUrl": "https://www.cjlogistics.com/ko/tool/parcel/tracking",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "contact_details",
      "office_contact_details",
      "driver_name",
      "signatory",
      "order_contents",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "recipient_address",
      "contact_details",
      "office_contact_details",
      "driver_name",
      "signatory",
      "order_contents",
      "parcel_count"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "cjlogistics.com"
      ],
      "pathPattern": "^/ko/tool/parcel/(?:tracking|newTracking)$",
      "params": [
        "gnbInvcNo"
      ]
    },
    {
      "domains": [
        "trace.cjlogistics.com"
      ],
      "pathPattern": "^/next/tracking\\.html$",
      "params": [
        "wblNo"
      ]
    },
    {
      "domains": [
        "trace.cjlogistics.com"
      ],
      "pathPattern": "^/web/(?:detail|info)\\.jsp$",
      "params": [
        "slipno"
      ]
    },
    {
      "domains": [
        "doortodoor.co.kr"
      ],
      "pathPattern": "^/parcel/doortodoor\\.do$",
      "params": [
        "invc_no"
      ]
    }
  ],
  "detection": []
}
