    "searchUrl": "https://tracking.closerlogistics.com/",
    "canaryUrl": "https://tracking.closerlogistics.com/",
    "shows": [
      "status",
      "progress_rail",
      "sender_name",
      "parcel_count",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "coordinates",
      "signatory",
      "failed_delivery_reason"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "sender_name",
      "failed_delivery_reason"
    ],
    "discarded": [
      "progress_rail",
      "parcel_count",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "coordinates",
      "signatory"
    ],
    "unavailable": [
      "location",
      "eta",
      "weight",
      "delivered_at",
      "offset_timestamps",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.closerlogistics.com"
      ],
      "path": "^/tracking/([^/?#]+)/?$"
    }
  ],
  "detection": []
