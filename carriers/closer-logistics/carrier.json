{
  "id": "closer-logistics",
  "displayName": "Closer Logistics",
  "aliases": [
    "Closer",
    "Closerlogistics"
  ],
  "region": {
    "countries": [
      "ES"
    ]
  },
  "brand": {
    "color": "#7bb4b8"
  },
  "selectable": true,
  "timezone": "Europe/Madrid",
  "tracking": {
    "mode": "automatic",
    "adapter": "closer-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 849
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "sender_name"
