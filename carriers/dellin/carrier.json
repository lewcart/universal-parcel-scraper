{
  "id": "dellin",
  "displayName": "Delovye Linii",
  "aliases": [
    "Деловые Линии",
    "Dellin",
    "DL",
    "Business Lines",
    "ГК Деловые Линии"
  ],
  "region": {
    "countries": [
      "RU"
    ]
  },
  "brand": {
    "color": "#fcaf17"
  },
  "selectable": true,
  "timezone": "Europe/Moscow",
  "tracking": {
    "mode": "automatic",
    "adapter": "dellin",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.dellin.ru/tracker/orders/{trackingNumber}/",
    "searchUrl": "https://www.dellin.ru/tracker/",
    "canaryUrl": "https://www.dellin.ru/tracker/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "eta",
      "origin",
      "destination"
    ],
    "unavailable": [
      "sender_name",
      "recipient_name",
      "weight",
      "dimensions",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "dellin.ru",
        "www.dellin.ru"
      ],
      "path": "^/tracker/orders/(\\d{2}-?\\d{11})/?$"
    },
    {
      "domains": [
        "dellin.ru",
        "www.dellin.ru"
      ],
      "pathPattern": "^/tracker/?$",
      "params": [
        "rwID"
      ]
    }
  ],
  "detection": []
}
