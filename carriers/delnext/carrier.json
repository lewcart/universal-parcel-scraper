{
  "id": "delnext",
  "displayName": "Delnext",
  "aliases": [],
  "region": {
    "countries": [
      "PT",
      "ES"
    ]
  },
  "brand": {
    "color": "#068dcf"
  },
  "selectable": true,
  "timezone": "Europe/Lisbon",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
