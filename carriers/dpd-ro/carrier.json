{
  "id": "dpd-ro",
  "displayName": "DPD Romania",
  "aliases": [
    "DPD Romania",
    "DPD România",
    "DPD (RO)",
    "DPD RO"
  ],
  "region": {
    "countries": [
      "RO"
    ]
  },
  "brand": {
    "color": "#dc0032"
  },
  "selectable": true,
  "timezone": "Europe/Bucharest",
  "tracking": {
    "mode": "automatic",
    "adapter": "dpd-ro",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 934
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "delivered_at"
  ],
  "portal": {
    "url": "https://tracking.dpd.ro/?shipmentNumber={trackingNumber}",
    "searchUrl": "https://www.dpd.com/ro/ro/",
    "canaryUrl": "https://www.dpd.com/ro/ro/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "delivered_at",
      "recipient_name",
      "proof_of_delivery",
      "return_number",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "delivered_at"
    ],
    "discarded": [
      "recipient_name",
      "proof_of_delivery",
      "return_number",
      "delivery_tracking_number"
    ],
    "unavailable": [
      "weight",
      "dimensions",
      "service_name",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.dpd.ro"
      ],
      "pathPattern": "^/?$",
      "params": [
        "shipmentNumber"
      ]
    },
    {
      "domains": [
        "services.dpd.ro"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "shipmentNumber"
      ]
    }
  ],
  "detection": []
}
