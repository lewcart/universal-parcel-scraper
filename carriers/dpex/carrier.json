{
  "id": "dpex",
  "displayName": "DPEX Worldwide",
  "aliases": [
    "DPEX"
  ],
  "region": {
    "countries": [
      "SG",
      "HK",
      "CN",
      "AU"
    ]
  },
  "brand": {
    "color": "#ec3a43"
  },
  "selectable": true,
  "timezone": "Asia/Singapore",
  "tracking": {
    "mode": "automatic",
    "adapter": "dpex",
    "steps": [
      "direct"
    ],
    "localClocks": true,
    "recognition": {
      "rank": 772
    }
  },
  "capabilities": [
    "history",
    "provider_code",
    "location",
    "destination_country"
  ],
  "portal": {
    "url": "https://dpex.com/track-and-trace/?cn={trackingNumber}",
    "searchUrl": "https://dpex.com/track-and-trace/",
    "canaryUrl": "https://dpex.com/track-and-trace/",
    "shows": [
      "status",
      "history",
      "provider_code",
      "location",
      "destination_country",
      "service_type",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "location",
      "destination_country"
    ],
    "discarded": [
      "service_type",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "dpex.com",
        "www.dpex.com"
      ],
      "pathPattern": "^/track-and-trace/?$",
      "params": [
        "cn"
      ]
    },
    {
      "domains": [
        "dpex.com",
        "www.dpex.com"
      ],
      "pathPattern": "^/Tools-And-Applications/Track-And-Trace/?$",
      "params": [
        "cn"
      ]
    },
    {
      "domains": [
        "tracking.frontierforce.com"
      ],
      "pathPattern": "^/(?:tracking(?:_search)?\\.aspx|go/plm-tracking(?:_search)?)/?$",
      "query": "^(?=(?:[^&]*&)*stid=dpexwwe(?:&|$))(?:[^&]*&)*?cn=([^&]+)"
    },
    {
      "domains": [
        "dpexonline.com",
        "www.dpexonline.com",
        "erp.dpex.com.cn"
      ],
      "pathPattern": "^/trace-and-track/index/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
