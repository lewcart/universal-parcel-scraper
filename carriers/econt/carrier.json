{
  "id": "econt",
  "displayName": "Econt",
  "aliases": [
    "Econt Express",
    "Еконт",
    "Еконт Експрес"
  ],
  "region": {
    "countries": [
      "BG"
    ]
  },
  "brand": {
    "color": "#234182"
  },
  "selectable": true,
  "timezone": "Europe/Sofia",
  "tracking": {
    "mode": "automatic",
    "adapter": "econt",
    "steps": [
      "direct",
      "refresh"
    ],
    "recognition": {
      "rank": 290
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "pickup_point"
  ],
  "portal": {
    "url": "https://www.econt.com/services/track-shipment/{trackingNumber}",
    "searchUrl": "https://www.econt.com/services/track-shipment",
    "canaryUrl": "https://www.econt.com/services/track-shipment",
    "shows": [
      "status",
      "history",
      "location",
      "parcel_count",
      "driver_name",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "pickup_point"
    ],
    "discarded": [
      "parcel_count",
      "driver_name",
      "order_references",
      "recipient_name",
      "sender_name"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "econt.com"
      ],
      "path": "^/(?:en/)?services/track-shipment/([^/?#]+)/?$"
    },
    {
      "domains": [
        "econt.com"
      ],
      "path": "^/tracking/([^/?#]+)/?$"
    },
    {
      "domains": [
        "econt.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "num"
      ]
    }
  ],
  "detection": []
}
