{
  "id": "emirates-post",
  "displayName": "Emirates Post",
  "aliases": [
    "Emirates Post Group",
    "بريد الإمارات"
  ],
  "region": {
    "countries": [
      "AE"
    ]
  },
  "brand": {
    "color": "#004a98"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "emirates-post",
    "steps": [
      "trawl"
    ],
    "browserRecognition": {
      "rank": 100
    },
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.emiratespost.ae/all-services/track-a-package/step-two?q={trackingNumber}",
    "searchUrl": "https://www.emiratespost.ae/all-services/track-a-package",
    "canaryUrl": "https://www.emiratespost.ae/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "sender_details",
      "recipient_details",
      "contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "sender_details",
      "recipient_details",
      "contact_details",
      "tracking_reference",
      "event_links"
    ],
    "unavailable": [
      "eta",
      "weight",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "emiratespost.ae",
        "www.emiratespost.ae"
      ],
      "pathPattern": "^/(?:(?:en|ar)/)?all-services/track-a-package/step-two/?$",
      "params": [
        "q"
      ]
    },
    {
      "domains": [
        "emiratespost.ae",
        "www.emiratespost.ae"
      ],
      "pathPattern": "^/Portal/Track/?$",
      "params": [
        "TrackingNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "emirates-post-s10",
      "pattern": "^[A-Z]{2}\\d{9}AE$",
      "confidence": "low",
      "preferred": true,
      "checksum": "s10"
    }
  ]
}
