    "canaryUrl": "https://envia.co/tracking",
    "shows": [],
    "scraped": [],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "envia.co"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "guia"
      ]
    },
    {
      "domains": [
        "portal.envia.co"
      ],
      "pathPattern": "^/OnLineRastreo(/Rastreo/Rastreo|/Consulta/Index)?/?$",
      "params": [
        "Guia"
      ]
    },
    {
      "domains": [
        "enviacolvanes.com.co"
      ],
      "pathPattern": "^/Contenido\\.aspx$",
      "params": [
        "rastreo"
      ]
    }
  ],
  "detection": []
