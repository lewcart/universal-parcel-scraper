{
  "id": "eurodis",
  "displayName": "EURODIS",
  "aliases": [
    "EURODIS GmbH"
  ],
  "region": {
    "countries": [
      "DE",
      "AT"
    ]
  },
  "brand": {
    "color": "#0b418b"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "eurodis",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://eurodis.com/track-trace?track_and_trace_hidden_field=trackCollo&trackCollo-input-of={trackingNumber}",
    "searchUrl": "https://eurodis.com/",
    "canaryUrl": "https://eurodis.com/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "destination_country",
      "parcel_count",
      "customer_reference",
      "delivery_partner",
      "delivery_tracking_number",
      "contact_details",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "parcel_count",
      "customer_reference",
      "contact_details",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory"
    ],
    "unavailable": [
      "weight",
      "eta",
      "service_name",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "eurodis.com"
      ],
      "pathPattern": "^/(?:[a-z]{2}/)?track-trace/?$",
      "params": [
        "trackCollo-input-of"
      ]
    }
  ],
  "detection": []
}
