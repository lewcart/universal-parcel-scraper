    "searchUrl": "https://evropat.bg/track/",
    "canaryUrl": "https://evropat.bg/track/",
    "shows": [
      "status",
      "history",
      "location",
      "driver_name",
      "signatory",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "driver_name",
      "signatory",
      "remarks"
    ],
    "unavailable": [
      "eta",
      "weight",
      "sender_name",
      "recipient_name",
      "proof_of_delivery",
      "provider_code",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "evropat.bg"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "barcode",
        "track"
      ]
    }
  ],
  "detection": []
}
