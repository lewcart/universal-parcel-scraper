{
  "id": "evropat",
  "displayName": "Evropat",
  "aliases": [
    "Европът",
    "Европът-2000"
  ],
  "region": {
    "countries": [
      "BG"
    ]
  },
  "brand": {
    "color": "#103683"
  },
  "selectable": true,
  "timezone": "Europe/Sofia",
  "tracking": {
    "mode": "automatic",
    "adapter": "evropat",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at"
  ],
  "portal": {
