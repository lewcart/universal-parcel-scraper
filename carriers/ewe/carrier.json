{
  "id": "ewe",
  "displayName": "EWE Group",
  "aliases": [
    "EWE",
    "EWE Global Express",
    "EWE Logistics"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#f3e127"
  },
  "selectable": true,
  "timezone": "Australia/Sydney",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
  "portal": {
