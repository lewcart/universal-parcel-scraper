    "searchUrl": "https://www.ewe.com.au/pages/tracking-order",
    "canaryUrl": "https://www.ewe.com.au/pages/tracking-order",
    "shows": [],
    "scraped": [],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "www.ewe.com.au",
        "ewe.com.au"
      ],
      "pathPattern": "^/pages/tracking-order/?$",
      "params": [
        "cno"
      ]
    },
    {
      "domains": [
        "www.ewe.com.au",
        "ewe.com.au"
      ],
      "pathPattern": "^/html/track\\.html$",
      "params": [
        "cno"
      ]
    },
    {
      "domains": [
        "trace.ewe.com.au"
      ],
      "pathPattern": "^/?$",
      "params": [
        "no"
      ]
    }
  ],
  "detection": []
}
