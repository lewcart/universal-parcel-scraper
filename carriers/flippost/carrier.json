    "searchUrl": "https://flippost.com/instruments/online/",
    "canaryUrl": "https://flippost.com/instruments/online/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "scan_times"
    ],
    "discarded": [
      "signatory"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "flippost.com",
        "www.flippost.com"
      ],
      "pathPattern": "^/instruments/online/?$",
      "params": [
        "number"
      ]
    }
  ],
  "detection": []
}
