{
  "id": "flippost",
  "displayName": "Flip Post",
  "aliases": [
    "FLIPPOST",
    "FlipPost",
    "Флиппост",
    "Флип Пост",
    "Flip Post Worldwide Express"
  ],
  "region": {
    "countries": [
      "RU"
    ]
  },
  "brand": {
    "color": "#2f4e77"
  },
  "selectable": true,
  "timezone": "Europe/Moscow",
  "tracking": {
    "mode": "automatic",
    "adapter": "flippost",
    "steps": [
      "direct",
      "retry"
    ],
