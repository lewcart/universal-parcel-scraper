{
  "id": "followmont",
  "displayName": "Followmont Transport",
  "aliases": [
    "Followmont",
    "Followmont Transport Pty Ltd"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#022160"
  },
  "selectable": true,
  "timezone": "Australia/Brisbane",
  "tracking": {
    "mode": "automatic",
    "adapter": "followmont",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta"
  ],
  "portal": {
    "url": "https://www.followmont.com.au/?page=fmt_template&fmt_template=track-trace&track-trace=track-trace-start-unsecured-user&consignmentNumber={trackingNumber}",
    "searchUrl": "https://www.followmont.com.au/",
    "canaryUrl": "https://www.followmont.com.au/",
    "shows": [
      "status",
      "location",
      "eta",
      "origin",
      "destination",
      "departure_date",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta"
    ],
    "discarded": [
      "origin",
      "destination",
      "departure_date",
      "parcel_count"
    ],
    "unavailable": [
      "offset_timestamps",
      "delivered_at",
      "weight",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.followmont.com.au",
        "followmont.com.au"
      ],
      "pathPattern": "^/$",
      "params": [
        "consignmentNumber"
      ]
    }
  ],
  "detection": []
}
