{
  "id": "gdex",
  "displayName": "GDEX",
  "aliases": [
    "GD Express",
    "GDex",
    "GD Express Sdn Bhd",
    "GDEX Malaysia"
  ],
  "region": {
    "countries": [
      "MY"
    ]
  },
  "brand": {
    "color": "#d71921"
  },
  "selectable": true,
  "timezone": "Asia/Kuala_Lumpur",
  "tracking": {
    "mode": "automatic",
    "adapter": "gdex",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 957
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
