    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "gdexpress.com",
        "www.gdexpress.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "consignmentno"
      ]
    },
    {
      "domains": [
        "web2.gdexpress.com"
      ],
      "pathPattern": "^/official/iframe/etracking(?:2|_v2)\\.php$",
      "params": [
        "capture"
      ]
    }
  ],
  "detection": [
    {
      "id": "gdex-1",
      "pattern": "^MY\\d{11}$",
      "confidence": "high"
    }
  ]
