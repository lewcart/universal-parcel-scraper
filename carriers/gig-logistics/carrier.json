{
  "id": "gig-logistics",
  "displayName": "GIG Logistics",
  "aliases": [
    "GIGL",
    "GIG Logistics Technologies Limited",
    "GIGGo"
  ],
  "region": {
    "countries": [
      "NG"
    ]
  },
  "brand": {
    "color": "#cf343a"
  },
  "selectable": true,
  "timezone": "Africa/Lagos",
  "tracking": {
    "mode": "automatic",
    "adapter": "gig-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://giglogistics.com/track-shipment/?waybill={trackingNumber}",
    "searchUrl": "https://giglogistics.com/track-shipment/",
    "canaryUrl": "https://giglogistics.com/track-shipment/",
    "shows": [
      "status",
      "history",
      "origin",
      "destination",
      "event_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "origin",
      "destination",
      "event_details",
      "recipient_name",
      "staff_details"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "giglogistics.com"
      ],
      "pathPattern": "^/track-shipment/?$",
      "params": [
        "waybill"
      ]
    }
  ],
  "detection": []
}
