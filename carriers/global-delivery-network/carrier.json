{
  "id": "global-delivery-network",
  "displayName": "Global Delivery Network",
  "aliases": [
    "GDN Parcel"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#00588a"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "global-delivery-network",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://pds.gdnparcel.com/pds_tracking.asp?track={trackingNumber}",
    "searchUrl": "https://gdnparcel.com/",
    "canaryUrl": "https://gdnparcel.com/",
    "shows": [
      "status",
      "history",
      "location",
      "destination",
      "recipient_name",
      "recipient_address",
      "weight",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "weight",
      "delivery_tracking_number"
    ],
    "unavailable": [
      "provider_code",
      "delivery_partner",
      "eta",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "gdnparcel.com",
        "www.gdnparcel.com",
        "pds.gdnparcel.com"
      ],
      "pathPattern": "^/pds_tracking\\.asp$",
      "params": [
        "track"
      ]
    }
  ],
  "detection": []
}
