{
  "id": "globalpost",
  "displayName": "GlobalPost",
  "aliases": [
    "Go GlobalPost",
    "GoGlobalPost",
    "Global Post",
    "Go Global Post",
    "GlobalPost UK"
  ],
  "region": {
    "countries": [
      "US",
      "GB"
    ]
  },
  "brand": {
    "color": "#11003a"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "globalpost",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "service_name",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.goglobalpost.com/track-detail/?t={trackingNumber}",
    "searchUrl": "https://www.goglobalpost.com/tracking/",
    "canaryUrl": "https://www.goglobalpost.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail",
      "service_name",
      "origin",
      "destination",
      "destination_country",
      "postcodes",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "progress_rail",
      "origin",
      "destination",
      "postcodes"
    ],
    "unavailable": [
      "eta",
      "delivered_at",
      "weight",
      "offset_timestamps",
      "provider_code",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.goglobalpost.com",
        "goglobalpost.com"
      ],
      "pathPattern": "^/(?:track-detail|track)/?$",
      "params": [
        "t"
      ]
    }
  ],
  "detection": [
    {
      "id": "globalpost-1",
      "pattern": "^GP[A-Z]{4}\\d{10}(?:US|GB)$",
      "confidence": "high"
    }
  ]
}
