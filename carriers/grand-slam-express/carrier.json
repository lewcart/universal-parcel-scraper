{
  "id": "grand-slam-express",
  "displayName": "Grand Slam Express",
  "aliases": [
    "Grandslam Express"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#f1592a"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "grand-slam-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.grandslamexpress.in/Web/Track?AwbNo={trackingNumber}",
    "searchUrl": "https://www.grandslamexpress.in/Web/Track",
    "canaryUrl": "https://www.grandslamexpress.in/Web/Track",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "destination_country",
      "awb_date",
      "parcel_count",
      "references"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country"
    ],
    "discarded": [
      "origin",
      "destination",
      "awb_date",
      "parcel_count",
      "references"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "weight",
      "service_name",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "grandslamexpress.in",
        "www.grandslamexpress.in"
      ],
      "pathPattern": "^/Web/Track/?$",
      "params": [
        "AwbNo"
      ]
    }
  ],
  "detection": []
}
