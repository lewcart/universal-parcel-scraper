{
  "id": "hanjin",
  "displayName": "Hanjin",
  "aliases": [
    "한진택배",
    "한진",
    "Hanjin Express",
    "Hanjin Transportation",
    "Hanjin Parcel"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#051469"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "hanjin",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 545
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at"
  ],
  "portal": {
    "url": "https://www.hanjin.com/kor/CMS/DeliveryMgr/WaybillResult.do?mCode=MN038&wblnum={trackingNumber}&schLang=KR",
    "searchUrl": "https://www.hanjin.com/kor/CMS/DeliveryMgr/WaybillSch.do",
    "canaryUrl": "https://www.hanjin.com/kor/CMS/DeliveryMgr/WaybillSch.do",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "progress_rail",
      "order_contents",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "payment_details",
      "driver_name",
      "contact_details",
      "related_awb_numbers"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "progress_rail",
      "order_contents",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "payment_details",
      "driver_name",
      "contact_details",
      "related_awb_numbers"
    ],
    "unavailable": [
      "eta",
      "weight",
      "offset_timestamps",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "hanjin.com"
      ],
      "pathPattern": "^/kor/CMS/DeliveryMgr/WaybillResult\\.do$",
      "params": [
        "wblnum"
      ]
    },
    {
      "domains": [
        "hanjin.co.kr",
        "hanjin.com"
      ],
      "pathPattern": "^/[Dd]elivery_html/inquiry/result_waybill\\.jsp$",
      "params": [
        "wbl_num"
      ]
    }
  ],
  "detection": []
}
