{
  "id": "happy-post",
  "displayName": "Happy-Post",
  "aliases": [
    "Happy Post"
  ],
  "region": {
    "countries": [
      "FR",
      "GB"
    ]
  },
  "brand": {
    "color": "#ff8500"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "happy-post",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 888
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://uk.happy-post.com/track/?id={trackingNumber}",
    "searchUrl": "https://uk.happy-post.com/track/",
    "canaryUrl": "https://uk.happy-post.com/track/",
    "shows": [
      "status",
      "history",
      "milestones",
      "delivery_partner",
      "delivery_tracking_number",
      "upstream_reference"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "milestones",
      "upstream_reference"
    ],
    "unavailable": [
      "location",
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "destination_country"
    ]
  },
  "links": [
    {
      "domains": [
        "happy-post.com"
      ],
      "pathPattern": "^/(?:fr/suivi|en/track)/?$",
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "uk.happy-post.com"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
