{
  "id": "ids-logistik",
  "displayName": "IDS Logistik",
  "aliases": [
    "IDS",
    "IDS Logistik GmbH",
    "IDS Germany"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#006bab"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "ids-logistik",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "label": "Delivery postcode",
        "type": "text",
        "help": "IDS shows a shipment only with the recipient's postcode.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "searchUrl": "https://www.ids-logistik.de/de/sendungsverfolgung",
    "canaryUrl": "https://www.ids-logistik.de/de/sendungsverfolgung",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "delivered_at",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "progress_rail",
      "office_contact_details"
    ],
    "unavailable": [
      "eta",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory",
      "proof_of_delivery",
      "pickup_point",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "ids-logistik.de"
      ],
      "pathPattern": "^/de/sendungsverfolgung/?$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": []
}
