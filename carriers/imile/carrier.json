{
  "id": "imile",
  "displayName": "iMile",
  "aliases": [
    "iMile Delivery",
    "iMile Express"
  ],
  "region": {
    "countries": [
      "AE",
      "SA",
      "AU",
      "BR",
      "MX",
      "CO",
      "IT",
      "CN"
    ]
  },
  "brand": {
    "color": "#0032a0"
  },
  "selectable": true,
  "timezone": "Asia/Dubai",
  "tracking": {
    "mode": "automatic",
    "adapter": "imile",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "location",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.imile.com/en/track?waybillNo={trackingNumber}",
    "searchUrl": "https://www.imile.com/en/track",
    "canaryUrl": "https://www.imile.com/en/track",
    "shows": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "delivery_tracking_number",
      "proof_of_delivery",
      "signatory",
      "contact_details",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "location",
      "destination_country"
    ],
    "discarded": [
      "eta",
      "delivery_tracking_number",
      "proof_of_delivery",
      "signatory",
      "contact_details",
      "payment_details"
    ],
    "unavailable": [
      "weight",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "imile.com",
        "www.imile.com"
      ],
      "pathPattern": "^/[^/]+/track/?$",
      "params": [
        "waybillNo"
      ]
    }
  ],
  "detection": [
    {
      "id": "imile-1",
      "pattern": "^IM\\d{14}$",
      "confidence": "low"
    }
  ]
}
