{
  "id": "intex-paketdienst",
  "displayName": "INTEX Paketdienst",
  "aliases": [
    "INTEX Paketdienst GmbH",
    "Intex Paketdienst"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#023051"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "intex-paketdienst",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "delivered_at",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.intex-paketdienst.de/sendungsstatus/index.php?sdnr={trackingNumber}&mid=1",
    "searchUrl": "https://www.intex-paketdienst.de/sendungsstatus/index.php",
    "canaryUrl": "https://www.intex-paketdienst.de/sendungsstatus/index.php",
    "shows": [
      "status",
      "history",
      "delivered_at",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "delivered_at",
      "destination_country"
    ],
    "discarded": [
      "destination",
      "delivery_tracking_number"
    ],
    "unavailable": [
      "location",
      "offset_timestamps",
      "eta",
      "provider_code",
      "service_name",
      "weight",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "pickup_point",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "intex-paketdienst.de"
      ],
      "pathPattern": "^/sendungsstatus/(?:index\\.php)?$",
      "params": [
        "sdnr"
      ]
    },
    {
      "domains": [
        "intex-paketdienst.de"
      ],
      "pathPattern": "^/website/tracking\\.html$",
      "params": [
        "sdnr"
      ]
    }
  ],
  "detection": []
}
