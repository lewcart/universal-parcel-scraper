{
  "id": "kunyoung",
  "displayName": "Kunyoung Express",
  "aliases": [
    "건영택배",
    "건영화물",
    "건영화물(주)",
    "Kunyong Express",
    "KUNYONG EXPRESS"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#04378c"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "kunyoung",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 622
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://mj.kunyoung.com/?invoiceNumber={trackingNumber}",
    "searchUrl": "https://mj.kunyoung.com/",
    "canaryUrl": "https://mj.kunyoung.com/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "driver_name",
      "contact_details",
      "delivery_photo"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at"
    ],
    "discarded": [
      "driver_name",
      "contact_details",
      "delivery_photo"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": [
        "mj.kunyoung.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "invoiceNumber"
      ]
    },
    {
      "domains": [
        "www.kunyoung.com",
        "kunyoung.com"
      ],
      "pathPattern": "^/goods/goods_0[12](?:__)?\\.php$",
      "params": [
        "mulno"
      ]
    }
  ],
  "detection": []
}
