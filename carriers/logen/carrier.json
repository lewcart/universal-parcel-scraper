  },
  "links": [
    {
      "domains": [
        "ilogen.com"
      ],
      "path": "^/(?:web|m)/personal/trace(?:\\.pop)?/([^/?#]+)/?$"
    },
    {
      "domains": [
        "ilogen.com"
      ],
      "pathPattern": "^/iLOGEN\\.Web\\.New/TRACE/Trace(?:No)?View\\.aspx$",
      "params": [
        "slipno"
      ]
    },
    {
      "domains": [
        "d2d.ilogen.com"
      ],
      "pathPattern": "^/d2d/delivery/invoice_tracesearch_(?:quick|link_detail|link_view)\\.jsp$",
      "params": [
        "slipno"
      ]
    }
  ],
  "detection": []
