{
  "id": "logistiq",
  "displayName": "Logistiq",
  "aliases": [],
  "region": {
    "countries": [
      "AE",
      "SA"
    ]
  },
  "brand": {
    "color": "#2e65f3"
  },
  "selectable": true,
  "timezone": "Asia/Dubai",
  "tracking": {
    "mode": "automatic",
    "adapter": "logistiq",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 768
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivered_at",
    "destination_country"
  ],
  "portal": {
    "url": "https://gecko.logistiq.io/#/order/tracking?awb={trackingNumber}",
    "searchUrl": "https://logistiq.io/track/",
    "canaryUrl": "https://logistiq.io/track/",
    "shows": [
      "status",
      "history",
      "location",
      "remarks",
      "progress_rail",
      "origin",
      "destination",
      "sender_address",
      "customer_reference",
      "invoice_reference",
      "payment_details",
      "order_contents"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "offset_timestamps",
      "remarks",
      "delivered_at",
      "destination_country"
    ],
    "discarded": [
      "progress_rail",
      "origin",
      "destination",
      "sender_address",
      "customer_reference",
      "invoice_reference",
      "payment_details",
      "order_contents"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "recipient_name",
      "recipient_address",
      "sender_name",
      "signatory",
      "proof_of_delivery",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "gecko.logistiq.io"
      ],
      "pathPattern": "^/?$",
      "fragment": "^/order/tracking\\?(?:[^#]*&)?awb=([^&]+)"
    }
  ],
  "detection": []
}
