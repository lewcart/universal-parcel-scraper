{
  "id": "mauritius-post",
  "displayName": "Mauritius Post",
  "aliases": [
    "Mauritius Post Ltd"
  ],
  "region": {
    "countries": [
      "MU"
    ]
  },
  "brand": {
    "color": "#f5d800"
  },
  "selectable": true,
  "timezone": "Indian/Mauritius",
  "tracking": {
    "mode": "automatic",
    "adapter": "mauritius-post",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.mauritiuspost.mu/track-trace/?tracking_code={trackingNumber}",
    "searchUrl": "https://www.mauritiuspost.mu/track-trace/",
    "canaryUrl": "https://www.mauritiuspost.mu/track-trace/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "origin",
      "destination",
      "transit_time"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "eta",
      "origin",
      "destination",
      "transit_time"
    ],
    "unavailable": [
      "provider_code",
      "weight",
      "service_name",
      "offset_timestamps",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.mauritiuspost.mu",
        "mauritiuspost.mu"
      ],
      "pathPattern": "^/track-trace/?$",
      "params": [
        "tracking_code"
      ]
    }
  ],
  "detection": []
}
