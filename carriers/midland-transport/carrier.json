{
  "id": "midland-transport",
  "displayName": "Midland Transport",
  "aliases": [
    "Midland Transport Limited",
    "Midland Courier"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#009057"
  },
  "selectable": true,
  "timezone": "America/Moncton",
  "tracking": {
    "mode": "automatic",
    "adapter": "midland-transport",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "service_name"
  ],
  "portal": {
    "url": "https://ship.midlandtransport.com/Tracking/TrackClientTrackings?TrackingNumber={trackingNumber}&Lang=0",
    "searchUrl": "https://ship.midlandtransport.com/Tracking/TrackClientTrackings",
    "canaryUrl": "https://ship.midlandtransport.com/Tracking/TrackClientTrackings",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "progress_rail",
      "eta",
      "service_name",
      "origin",
      "destination",
      "destination_country",
      "sender_name",
      "contact_details",
      "customer_reference",
      "parcel_count",
      "related_tracking_numbers"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "service_name",
      "destination_country"
    ],
    "discarded": [
      "progress_rail",
      "origin",
      "destination",
      "sender_name",
      "contact_details",
      "customer_reference",
      "parcel_count",
      "related_tracking_numbers"
    ],
    "unavailable": [
      "weight",
      "recipient_name",
      "signatory",
      "proof_of_delivery",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "ship.midlandtransport.com"
      ],
      "pathPattern": "^/Tracking/TrackClientTrackings/?$",
      "params": [
        "TrackingNumber"
      ]
    }
  ],
  "detection": []
}
