{
  "id": "mrl-global",
  "displayName": "MRL Global",
  "aliases": [
    "MRL Logistics",
    "Sampson Express"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#0071a6"
  },
  "selectable": true,
  "timezone": "Australia/Sydney",
  "tracking": {
    "mode": "automatic",
    "adapter": "mrl-global",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://www.mrlglobal.com/tracking/?connoteno={trackingNumber}",
    "searchUrl": "https://www.mrlglobal.com/tracking/",
    "canaryUrl": "https://www.mrlglobal.com/tracking/",
    "shows": [
      "status",
      "history",
      "progress_rail",
      "delivered_at",
      "signatory",
      "customer_reference",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [
      "progress_rail",
      "delivered_at",
      "signatory",
      "customer_reference",
      "parcel_count"
    ],
    "unavailable": [
      "eta",
      "weight",
      "recipient_name",
      "sender_name",
      "proof_of_delivery",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.mrlglobal.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "connoteno"
      ]
    }
  ],
  "detection": []
}
