  "tracking": {
    "mode": "automatic",
    "adapter": "nim-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 631
    }
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
