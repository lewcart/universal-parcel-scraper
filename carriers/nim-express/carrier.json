{
  "id": "nim-express",
  "displayName": "Nim Express",
  "aliases": [
    "NIMEXPRESS",
    "นิ่มเอ็กซ์เพรส"
  ],
  "region": {
    "countries": [
      "TH"
    ]
  },
  "brand": {
    "color": "#0967b3"
  },
  "selectable": true,
