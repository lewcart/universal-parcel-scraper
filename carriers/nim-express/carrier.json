      "history",
      "location",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "depot_code"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "provider_code",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "nimexpress.com",
        "www.nimexpress.com"
      ],
      "pathPattern": "^/web/p/tracking/?$",
      "params": [
        "h_i",
        "i"
      ]
    }
  ],
  "detection": []
