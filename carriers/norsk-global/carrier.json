{
  "id": "norsk-global",
  "displayName": "Norsk Global",
  "aliases": [
    "Norsk",
    "Norsk-Global"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#114433"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "norsk-global",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 845
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://norsk.trackmyparcel.info/gb/tracking/{trackingNumber}",
    "searchUrl": "https://norsk.trackmyparcel.info/",
    "canaryUrl": "https://norsk.trackmyparcel.info/",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "recipient_name",
      "postcodes",
      "signatory",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "recipient_name",
      "postcodes",
      "signatory",
      "delivered_at"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "provider_code",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "norsk.trackmyparcel.info"
      ],
      "path": "^/(?:[a-z]{2}/)?tracking/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "norsk-global-pkg",
      "pattern": "^PKG\\d{12}$",
      "confidence": "low"
    }
  ]
}
