{
  "id": "northline",
  "displayName": "Northline",
  "aliases": [
    "Northline Transport",
    "Northline Pty Ltd"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#000000"
  },
  "selectable": true,
  "timezone": "Australia/Sydney",
  "tracking": {
    "mode": "automatic",
    "adapter": "northline",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "offset_timestamps",
    "eta",
    "delivered_at"
  ],
  "portal": {
    "url": "https://track.northline.com.au/status/{trackingNumber}",
    "searchUrl": "https://track.northline.com.au/",
    "canaryUrl": "https://track.northline.com.au/",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "provider_code",
      "offset_timestamps",
      "eta",
      "delivered_at",
      "customer_reference",
      "origin",
      "destination",
      "postcodes"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "offset_timestamps",
      "eta",
      "delivered_at"
    ],
    "discarded": [
      "progress_rail",
      "customer_reference",
      "origin",
      "destination",
      "postcodes"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "track.northline.com.au"
      ],
      "path": "^/status/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
