{
  "id": "nz-couriers",
  "displayName": "New Zealand Couriers",
  "aliases": [
    "NZ Couriers",
    "NZCouriers",
    "NZC"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#ffc900"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "nz-couriers",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "delivered_at",
    "delivery_partner",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://nzcouriers.co.nz/track?query={trackingNumber}",
    "searchUrl": "https://nzcouriers.co.nz/tools/track-a-parcel/",
    "canaryUrl": "https://nzcouriers.co.nz/tools/track-a-parcel/",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "eta",
      "delivered_at",
      "delivery_partner"
    ],
    "discarded": [
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "nzcouriers.co.nz"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "query"
      ]
    }
  ],
  "detection": []
}
