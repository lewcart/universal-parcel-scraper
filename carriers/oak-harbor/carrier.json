{
  "id": "oak-harbor",
  "displayName": "Oak Harbor Freight Lines",
  "aliases": [
    "Oak Harbor",
    "Oak Harbor Freight Lines, Inc.",
    "OHFL"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#1e2251"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "oak-harbor",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://www.oakh.com/quicktrace&PRO={trackingNumber}",
    "searchUrl": "https://www.oakh.com/page/tracing",
    "canaryUrl": "https://www.oakh.com/page/tracing",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "customer_reference",
      "sender_name",
      "recipient_name",
      "origin",
      "destination",
      "postcodes",
      "signatory",
      "office_contact_details",
      "office_addresses",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "customer_reference",
      "sender_name",
      "recipient_name",
      "origin",
      "destination",
      "postcodes",
      "signatory",
      "office_contact_details",
      "office_addresses",
      "proof_of_delivery"
    ],
    "unavailable": [
      "offset_timestamps",
      "delivered_at",
      "weight",
      "service_name",
      "provider_code",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "www.oakh.com",
        "oakh.com"
      ],
      "path": "^/quicktrace&[Pp][Rr][Oo]=([^/?#&]+)/?$"
    }
  ],
  "detection": []
}
