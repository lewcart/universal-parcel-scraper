{
  "id": "oca",
  "displayName": "OCA",
  "aliases": [
    "OCA Argentina",
    "Organización Coordinadora Argentina",
    "OCA e-Pak"
  ],
  "region": {
    "countries": [
      "AR"
    ]
  },
  "brand": {
    "color": "#592c82"
  },
  "selectable": true,
  "timezone": "America/Argentina/Buenos_Aires",
  "tracking": {
    "mode": "automatic",
    "adapter": "oca",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 974
    }
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://www.oca.com.ar/Seguimiento/Paquetes/{trackingNumber}",
    "searchUrl": "https://www.oca.com.ar/Seguimiento/BuscarEnvio",
    "canaryUrl": "https://www.oca.com.ar/Seguimiento/BuscarEnvio",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "progress_rail"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.oca.com.ar",
        "oca.com.ar"
      ],
      "path": "^/Seguimiento/Paquetes/([^/?#]+)/?$"
    },
    {
      "domains": [
        "www1.oca.com.ar",
        "www9.oca.com.ar"
      ],
      "pathPattern": "^/OEPTrackingWeb/detalleenviore\\.asp$",
      "params": [
        "numero"
      ]
    },
    {
      "domains": [
        "www1.oca.com.ar",
        "www9.oca.com.ar"
      ],
      "pathPattern": "^/OEPTrackingWeb/trackingenvio\\.asp$",
      "params": [
        "numero1"
      ]
    },
    {
      "domains": [
        "www1.oca.com.ar",
        "www4.oca.com.ar",
        "www5.oca.com.ar"
      ],
      "pathPattern": "^/ocaepakNet/Views/ConsultaTracking/TrackingConsult\\.aspx$",
      "params": [
        "numberTracking"
      ]
    }
  ],
  "detection": []
}
