{
  "id": "packs",
  "displayName": "Packs",
  "aliases": [],
  "region": {
    "countries": [
      "NL",
      "BE",
      "LU"
    ]
  },
  "brand": {
    "color": "#e11f1d"
  },
  "selectable": true,
  "timezone": "Europe/Amsterdam",
  "tracking": {
    "mode": "automatic",
    "adapter": "packs",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "label": "Delivery postcode",
        "type": "text",
        "help": "Packs shows a shipment only with the recipient's postcode.",
        "pattern": "^(?:[1-9][0-9]{3} ?[A-Za-z]{2}|(?:(?:[Bb][Ee]?|[Ll][Uu]?)[ \\-]?)?[1-9][0-9]{3})$",
        "maxLength": 7,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "delivered_at",
    "eta",
    "eta_window",
    "canonical_tracking_number"
  ],
  "portal": {
    "searchUrl": "https://www.packs.nl/track-trace/",
    "canaryUrl": "https://www.packs.nl/track-trace/",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "eta",
      "eta_window",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "canonical_tracking_number",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "eta_window",
      "delivered_at",
      "canonical_tracking_number"
    ],
    "discarded": [
      "progress_rail",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "delivery_options"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name",
      "signatory",
      "proof_of_delivery",
      "pickup_point",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "www.packs.nl",
        "packs.nl"
      ],
      "pathPattern": "^/(?:track-trace|tracktrace)/?$",
      "params": [
        "zendingnr"
      ]
    }
  ],
  "detection": []
}
