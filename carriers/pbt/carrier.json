{
  "id": "pbt",
  "displayName": "PBT",
  "aliases": [
    "PBT Couriers",
    "PBT Express Freight Network",
    "PBT Transport",
    "PBT Group",
    "PBTrack"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#008fbe"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "pbt",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 623
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "weight"
  ],
  "portal": {
    "url": "https://www.pbt.nz/tracking-result/?consignmentNumber={trackingNumber}",
    "searchUrl": "https://www.pbt.nz/",
    "canaryUrl": "https://www.pbt.nz/",
    "shows": [
      "status",
      "history",
      "location",
      "weight",
      "origin",
      "destination",
      "parcel_count",
      "volume",
      "customer_reference",
      "booking_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "weight"
    ],
    "discarded": [
      "origin",
      "destination",
      "parcel_count",
      "volume",
      "customer_reference",
      "booking_details"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "delivered_at",
      "service_name",
      "provider_code",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "www.pbt.nz",
        "pbt.nz"
      ],
      "pathPattern": "^/tracking-result/?$",
      "params": [
        "consignmentNumber",
        "consignmentnumber"
      ]
    },
    {
      "domains": [
        "www.pbt.com",
        "pbt.com",
        "www.pbt.co.nz",
        "pbt.co.nz"
      ],
      "pathPattern": "^/(?:track|nick)/results\\.cfm$",
      "params": [
        "ticketNo"
      ]
    },
    {
      "domains": [
        "www.pbt.co.nz",
        "pbt.co.nz"
      ],
      "pathPattern": "^/landing\\.aspx$",
      "params": [
        "track"
      ]
    }
  ],
  "detection": []
}
