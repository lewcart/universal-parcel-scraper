{
  "id": "pitney-bowes",
  "displayName": "Pitney Bowes",
  "aliases": [
    "Pitney Bowes Global Ecommerce",
    "Pitney Bowes Expedited Parcel Service",
    "eBay Global Shipping Program",
    "PBI"
  ],
  "region": {
    "countries": [
      "GB",
      "US"
    ]
  },
  "brand": {
    "color": "#3e53a4"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "pitney-bowes",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "service_name",
    "weight"
  ],
  "portal": {
    "url": "https://trackpb.shipment.co/track/{trackingNumber}",
    "searchUrl": "https://trackpb.shipment.co/track",
    "canaryUrl": "https://trackpb.shipment.co/track",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name",
      "weight"
    ],
    "discarded": [
      "delivery_partner"
    ],
    "unavailable": [
      "provider_code",
      "eta",
      "offset_timestamps",
      "delivered_at",
      "delivery_tracking_number",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "trackpb.shipment.co"
      ],
      "path": "^/track/([^/?#]+)/?$"
    },
    {
      "domains": [
        "trackpb.shipment.co"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "number"
      ]
    },
    {
      "domains": [
        "parceltracking.pb.com"
      ],
      "path": "^/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "pitney-bowes-1",
      "pattern": "^UPAA[A-Z]\\d{15}$",
      "confidence": "high"
    },
    {
      "id": "pitney-bowes-2",
      "pattern": "^UPBE[0-9A-F]{16}$",
      "confidence": "high"
    },
    {
      "id": "pitney-bowes-3",
      "pattern": "^PBX[A-Z]{2}(?:\\d{9}|[0-9A-F]{15})$",
      "confidence": "high"
    }
  ]
}
