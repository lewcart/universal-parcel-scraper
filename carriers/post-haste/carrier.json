{
  "id": "post-haste",
  "displayName": "Post Haste",
  "aliases": [
    "Post Haste Couriers",
    "Posthaste",
    "PostHaste"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#24b2d8"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "post-haste",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "delivered_at",
    "delivery_partner",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://posthaste.co.nz/track?query={trackingNumber}",
    "searchUrl": "https://posthaste.co.nz/tools/track/",
    "canaryUrl": "https://posthaste.co.nz/tools/track/",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "eta",
      "delivered_at",
      "delivery_partner"
    ],
    "discarded": [
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "posthaste.co.nz",
        "www.posthaste.co.nz"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "query"
      ]
    }
  ],
  "detection": []
}
