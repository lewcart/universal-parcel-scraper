{
  "id": "post-haste",
  "displayName": "Post Haste",
  "aliases": [
    "Post Haste Couriers",
    "Posthaste",
    "PostHaste"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#24b2d8"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "post-haste",
    "steps": [
      "direct"
    ],
    "requirements": [
      {
        "field": "trackingUrl",
        "validator": "freightwaysCapabilityUrl",
        "optional": true,
        "label": "Post Haste tracking link",
        "type": "url",
        "placeholder": "https://receiver.posthaste.co.nz/?consignmentid=CU..\u2026",
        "help": "The link in the shipping email names the sender's account, which some parcels need to be found."
      }
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "delivered_at",
    "delivery_partner",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://posthaste.co.nz/track?query={trackingNumber}",
    "searchUrl": "https://posthaste.co.nz/tools/track/",
    "canaryUrl": "https://posthaste.co.nz/tools/track/",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "eta",
      "delivered_at",
      "delivery_partner"
    ],
    "discarded": [
      "progress_rail",
      "parcel_count",
      "signatory",
      "proof_of_delivery",
      "delivery_instructions"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "receiver.posthaste.co.nz"
      ],
      "pathPattern": "^/?$",
      "query": "(?:^|&)consignmentid=CU\\.\\.([A-Z0-9]{4,40})\\.[A-Z0-9]\\.[A-Z0-9]{3,16}\\.\\d{1,3}(?=&|$)",
      "keepsCapabilityUrl": true
    },
    {
      "domains": [
        "receiver.posthaste.co.nz",
        "posthaste.co.nz"
      ],
      "pathPattern": "^/(?:[a-z]+/servlet/ITNG_TAndTServlet/?)?$",
      "query": "^(?=(?:.*&)?customer_(?:number|id)=[A-Z0-9]{3,16}(?:&|$))(?:.*&)?consignment_id(?:_ref)?=([A-Z0-9]{4,40})(?=&|$)",
      "keepsCapabilityUrl": true
    },
    {
      "domains": [
        "posthaste.co.nz",
        "www.posthaste.co.nz"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "query"
      ]
    },
    {
      "domains": [
        "posthaste.co.nz"
      ],
      "pathPattern": "^/[a-z]+/servlet/ITNG_TAndTServlet/?$",
      "params": [
        "consignment_id_ref",
        "consignment_id",
        "label_number"
      ]
    },
    {
      "domains": [
        "receiver.posthaste.co.nz"
      ],
      "pathPattern": "^/?$",
      "query": "(?:^|&)(?:consignmentid|track|query|consignment_id_ref|consignment_id|label_number)=(?:CU\\.\\.)?([^&.]+)(?=[.&]|$)"
    }
  ],
  "detection": []
}
