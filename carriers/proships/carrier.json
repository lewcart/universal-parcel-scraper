{
  "id": "proships",
  "displayName": "ProShips",
  "aliases": [
    "PROSHIPS",
    "ProShips e-commerce Logistics"
  ],
  "region": {
    "countries": [
      "CO"
    ]
  },
  "brand": {
    "color": "#f8b909"
  },
  "selectable": true,
  "timezone": "America/Bogota",
  "tracking": {
    "mode": "automatic",
    "adapter": "proships",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://proships.com/tracking?tracking={trackingNumber}",
    "searchUrl": "https://proships.com/tracking/",
    "canaryUrl": "https://proships.com/tracking/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [],
    "unavailable": [
      "location",
      "provider_code",
      "eta",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "weight",
      "pickup_point",
      "delivery_partner",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "proships.com",
        "www.proships.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "tracking",
        "code"
      ]
    }
  ],
  "detection": []
}
