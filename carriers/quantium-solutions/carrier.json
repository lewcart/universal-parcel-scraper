{
  "id": "quantium-solutions",
  "displayName": "Quantium Solutions",
  "aliases": [
    "Quantium",
    "Quantium Worldwide",
    "Quantium Solutions International"
  ],
  "region": {
    "countries": [
      "SG",
      "MY",
      "TH",
      "AU"
    ]
  },
  "brand": {
    "color": "#00474f"
  },
  "selectable": true,
  "timezone": "Asia/Singapore",
  "tracking": {
    "mode": "automatic",
    "adapter": "quantium-solutions",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 809
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "destination_country"
  ],
  "portal": {
    "url": "https://track.quantiumworldwide.com/?trackno={trackingNumber}",
    "searchUrl": "https://track.quantiumworldwide.com/",
    "canaryUrl": "https://track.quantiumworldwide.com/",
    "shows": [
      "status",
      "history",
      "remarks",
      "customer_reference",
      "delivery_tracking_number",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "remarks",
      "destination_country"
    ],
    "discarded": [
      "customer_reference",
      "delivery_tracking_number",
      "origin",
      "destination"
    ],
    "unavailable": [
      "location",
      "provider_code",
      "offset_timestamps",
      "eta",
      "weight",
      "delivered_at",
      "delivery_partner",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "track.quantiumworldwide.com",
        "track.quantiumsolutions.com"
      ],
      "pathPattern": "^/$",
      "params": [
        "trackno"
      ]
    },
    {
      "domains": [
        "itapps.quantiumworldwide.com"
      ],
      "pathPattern": "^/itcms_tracking/home/itcms/?$",
      "params": [
        "as_order_no"
      ]
    }
  ],
  "detection": []
}
