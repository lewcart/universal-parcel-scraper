{
  "id": "roadie",
  "displayName": "Roadie",
  "aliases": [
    "Roadie, a UPS Company",
    "Roadie Inc."
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#76cccd"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "roadie",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 28,
      "pattern": "^1R(?:[0-9A-Z]{26}|[0-9A-F]{14})$"
    }
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://track.roadie.com/id/{trackingNumber}",
    "searchUrl": "https://track.roadie.com/",
    "helpUrl": "https://support.roadie.com/support/s/contactsupport",
    "canaryUrl": "https://track.roadie.com/",
    "shows": [
      "status",
      "history",
      "eta",
      "sender_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [
      "sender_name",
      "recipient_address"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "track.roadie.com"
      ],
      "path": "^/(?:[^/]+/)?id/([^/?#]+)/?$"
    },
    {
      "domains": [
        "track.roadie.com"
      ],
      "path": "^/track/([^/?#]+)/?$"
    },
    {
      "domains": [
        "track.roadie.com"
      ],
      "pathPattern": "^/(?:[^/]+/)?track/?$",
      "params": [
        "tracking_number"
      ]
    }
  ],
  "detection": [
    {
      "id": "roadie-1",
      "pattern": "^1R[0-9A-Z]{26}$",
      "confidence": "high"
    },
    {
      "id": "roadie-2",
      "pattern": "^1R[0-9A-F]{14}$",
      "confidence": "high"
    }
  ]
}
