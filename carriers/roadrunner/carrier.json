{
  "id": "roadrunner",
  "displayName": "Roadrunner",
  "aliases": [
    "Roadrunner Freight",
    "Roadrunner Transportation Systems",
    "RRTS",
    "Roadrunner LTL"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#e5481c"
  },
  "selectable": true,
  "timezone": "America/Chicago",
  "tracking": {
    "mode": "automatic",
    "adapter": "roadrunner",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 733
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "service_name"
  ],
