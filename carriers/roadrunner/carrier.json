    "searchUrl": "https://freight.rrts.com/Tools/Tracking/Pages/default.aspx",
    "canaryUrl": "https://tools.rrts.com/LTLTrack/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "service_name",
      "progress_rail",
      "delivered_at",
      "departure_date",
      "weight",
      "parcel_count",
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "origin",
      "destination",
      "coordinates",
      "customer_reference",
      "tracking_alias",
      "payment_details",
      "delivery_options",
      "office_contact_details",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "service_name"
    ],
    "discarded": [
      "progress_rail",
      "delivered_at",
      "departure_date",
      "weight",
      "parcel_count",
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "origin",
      "destination",
      "coordinates",
      "customer_reference",
      "tracking_alias",
      "payment_details",
      "delivery_options",
      "office_contact_details",
      "proof_of_delivery"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "freight.rrts.com",
        "www.rrts.com",
        "rrts.com"
      ],
      "pathPattern": "^/Tools/Tracking/Pages/MultipleResults\\.aspx$",
      "params": [
        "PROS"
      ]
    },
    {
      "domains": [
        "tools.rrts.com"
      ],
      "pathPattern": "^/LTLTrack/?$",
      "params": [
        "searchValues"
      ]
    }
  ],
  "detection": []
