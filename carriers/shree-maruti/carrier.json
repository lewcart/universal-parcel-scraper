{
  "id": "shree-maruti",
  "displayName": "Shree Maruti Courier",
  "aliases": [
    "Shree Maruti",
    "Shree Maruti Courier Services",
    "Shree Maruti Courier Services Private Limited",
    "Shree Maruti Courier Service"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#2a3680"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
  "portal": {
    "url": "https://shreemaruti.com/track-shipment/?awb={trackingNumber}",
    "searchUrl": "https://shreemaruti.com/track-shipment/",
    "canaryUrl": "https://shreemaruti.com/track-shipment/",
    "shows": [],
    "scraped": [],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "shreemaruti.com"
      ],
      "pathPattern": "^/track-shipment/?$",
      "params": [
        "awb"
      ]
    },
    {
      "domains": [
        "shreemaruti.com",
        "clients.shreemaruti.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "d"
      ]
    },
    {
      "domains": [
        "tracking.shreemaruti.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "d",
        "shipmentNo"
      ]
    },
    {
      "domains": [
        "tracking.shreemaruti.com"
      ],
      "path": "^/(\\d{12,14})/?$"
    },
    {
      "domains": [
        "shreemaruti.com",
        "shreemaruticourier.com"
      ],
      "pathPattern": "^/track-your-shipment/?$",
      "params": [
        "tracking_id"
      ]
    }
  ],
  "detection": []
}
