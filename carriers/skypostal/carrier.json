      "history",
      "location",
      "provider_code",
      "delivery_tracking_number",
      "related_tracking_numbers",
      "comments",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "delivery_tracking_number",
      "related_tracking_numbers",
      "comments",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.skypostal.com"
      ],
      "pathPattern": "^/(?:single-tracking\\.aspx)?$",
      "params": [
        "trck_number"
      ]
    }
