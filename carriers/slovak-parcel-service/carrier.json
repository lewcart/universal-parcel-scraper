{
  "id": "slovak-parcel-service",
  "displayName": "Slovak Parcel Service",
  "aliases": [
    "SPS"
  ],
  "region": {
    "countries": [
      "SK"
    ]
  },
  "brand": {
    "color": "#f58220"
  },
  "selectable": true,
  "timezone": "Europe/Bratislava",
  "tracking": {
    "mode": "automatic",
    "adapter": "slovak-parcel-service",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true,
    "recognition": {
      "rank": 180
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "weight"
  ],
  "portal": {
    "url": "https://www.sps-sro.sk/moja-zasielka/?shipment_id={trackingNumber}",
    "searchUrl": "https://www.sps-sro.sk/moja-zasielka/",
    "canaryUrl": "https://www.sps-sro.sk/moja-zasielka/",
    "shows": [
      "status",
      "history",
      "location",
      "weight",
      "sender_name",
      "recipient_name",
      "postcodes",
      "customer_reference",
      "tracking_alias",
      "delivery_partner_reference",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "weight"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "postcodes",
      "customer_reference",
      "tracking_alias",
      "delivery_partner_reference",
      "parcel_count"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "sps-sro.sk"
      ],
      "pathPattern": "^/(?:en/)?(?:moja-zasielka|sledovanie-zasielky|track-trace)/?$",
      "params": [
        "shipment_id"
      ]
    }
  ],
  "detection": [
    {
      "id": "slovak-parcel-service-1",
      "pattern": "^703\\d{11}$",
      "confidence": "low"
    }
  ]
}
