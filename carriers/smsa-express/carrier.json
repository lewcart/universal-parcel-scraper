{
  "id": "smsa-express",
  "displayName": "SMSA Express",
  "aliases": [
    "SMSA",
    "سمسا",
    "سمسا إكسبرس"
  ],
  "region": {
    "countries": [
      "SA"
    ]
  },
  "brand": {
    "color": "#fc671a"
  },
  "selectable": true,
  "timezone": "Asia/Riyadh",
  "tracking": {
    "mode": "automatic",
    "adapter": "smsa-express",
    "steps": [
      "app",
      "retry",
      "direct"
    ],
    "recognition": {
      "rank": 448
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "weight",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.smsaexpress.com/sa/trackingdetails?tracknumbers={trackingNumber}",
    "searchUrl": "https://www.smsaexpress.com/",
    "canaryUrl": "https://www.smsaexpress.com/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "origin",
      "destination",
      "destination_country",
      "parcel_count",
      "progress_rail",
      "signatory",
      "sender_name",
      "recipient_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "destination_country",
      "provider_code",
      "offset_timestamps"
    ],
    "discarded": [
      "origin",
      "destination",
      "parcel_count",
      "progress_rail",
      "signatory",
      "sender_name",
      "recipient_name"
    ],
    "unavailable": [
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "smsaexpress.com",
        "www.smsaexpress.com"
      ],
      "pathPattern": "^/(?:[a-z]{2}/){0,2}trackingdetails/?$",
      "params": [
        "tracknumbers",
        "tracknumbers[0]"
      ]
    },
    {
      "domains": [
        "smsaexpress.com",
        "www.smsaexpress.com"
      ],
      "pathPattern": "^/(?:Track|arabic/TrackAr)\\.aspx$",
      "params": [
        "tracknumbers"
      ]
    }
  ],
  "detection": []
}
