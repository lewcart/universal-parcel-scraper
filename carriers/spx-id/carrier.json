{
  "id": "spx-id",
  "displayName": "SPX Express Indonesia",
  "aliases": [
    "Shopee Express Indonesia",
    "Shopee Xpress Indonesia",
    "SPX Indonesia"
  ],
  "region": {
    "countries": [
      "ID"
    ]
  },
  "brand": {
    "color": "#ee4d2d"
  },
  "selectable": true,
  "timezone": "Asia/Jakarta",
  "tracking": {
    "mode": "automatic",
    "adapter": "spx-id",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://spx.co.id/track?{trackingNumber}",
    "searchUrl": "https://spx.co.id/track",
    "canaryUrl": "https://spx.co.id/track",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "progress_rail",
      "seller_location",
      "office_addresses",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight",
      "pickup_point",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "spx.co.id"
      ],
      "pathPattern": "^/(?:m/)?track/?$",
      "query": "^(SPXID\\d{11}[0-9A-Z]|ID\\d{12}[0-9A-Z]?)$"
    },
    {
      "domains": [
        "spx.co.id"
      ],
      "path": "^/detail/(SPXID\\d{11}[0-9A-Z]|ID\\d{12}[0-9A-Z]?)/?$"
    }
  ],
  "detection": [
    {
      "id": "spx-id-1",
      "pattern": "^SPXID\\d{11}[0-9A-Z]$",
      "confidence": "high"
    },
    {
      "id": "spx-id-2",
      "pattern": "^ID\\d{12}[0-9A-Z]?$",
      "confidence": "low"
    }
  ]
}
