{
  "id": "stallion-express",
  "displayName": "Stallion Express",
  "aliases": [
    "Stallion"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#fbad40"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "stallion-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 105
    }
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "service_name",
    "delivery_partner",
    "delivery_tracking_number",
    "destination_country"
  ],
  "portal": {
    "url": "https://stallion.ca/track/?tracking={trackingNumber}",
    "searchUrl": "https://stallion.ca/track/",
    "canaryUrl": "https://stallion.ca/track/",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "delivery_partner",
      "delivery_tracking_number",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "delivery_partner",
      "delivery_tracking_number",
      "destination_country"
    ],
    "discarded": [
      "destination"
    ],
    "unavailable": [
      "eta",
      "weight",
      "sender_name",
      "recipient_name",
      "provider_code",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "stallion.ca",
        "stallionexpress.ca"
      ],
      "pathPattern": "^/track(?:ing)?/?$",
      "params": [
        "tracking"
      ]
    },
    {
      "domains": [
        "ship.stallion.ca",
        "ship.stallionexpress.ca"
      ],
      "path": "^/track(?:ing)?/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "stallion-express-1",
      "pattern": "^2\\d(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])(?=\\d{0,3}[A-Z])[0-9A-Z]{4}$",
      "confidence": "low"
    },
    {
      "id": "stallion-express-2",
      "pattern": "^SE2\\d(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])(?=\\d{0,3}[A-Z])[0-9A-Z]{4}$",
      "confidence": "low",
      "preferred": true
    }
  ]
}
