{
  "id": "sundarban-courier",
  "displayName": "Sundarban Courier Service",
  "aliases": [
    "Sundarban Courier",
    "Sundarban Courier Service (Pvt.) Ltd.",
    "SCS"
  ],
  "region": {
    "countries": [
      "BD"
    ]
  },
  "brand": {
    "color": "#0b4c9f"
  },
  "selectable": true,
  "timezone": "Asia/Dhaka",
  "tracking": {
    "mode": "automatic",
    "adapter": "sundarban-courier",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "pickup_point"
  ],
  "portal": {
    "url": "https://operation.sundarbancourierltd.com/?cnnumber={trackingNumber}",
    "searchUrl": "https://operation.sundarbancourierltd.com/",
    "canaryUrl": "https://operation.sundarbancourierltd.com/",
    "shows": [
      "status",
      "history",
      "location",
      "pickup_point",
      "origin",
      "destination",
      "departure_date",
      "parcel_count",
      "order_contents",
      "recipient_contact",
      "event_details",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "pickup_point"
    ],
    "discarded": [
      "origin",
      "destination",
      "departure_date",
      "parcel_count",
      "order_contents",
      "recipient_contact",
      "event_details",
      "remarks"
    ],
    "unavailable": [
      "offset_timestamps",
      "scan_times",
      "eta",
      "weight",
      "delivered_at",
      "service_name",
      "proof_of_delivery",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "operation.sundarbancourierltd.com",
        "tracking.sundarbancourierltd.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "cnnumber"
      ]
    }
  ],
  "detection": []
}
