    "scraped": [
      "status",
      "history",
      "location",
      "weight",
      "destination_country"
    ],
    "discarded": [
      "origin",
      "destination",
      "item_category",
      "progress_rail",
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "contact_details",
