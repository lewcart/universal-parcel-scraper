{
  "id": "taqbin-hk",
  "displayName": "TA-Q-BIN Hong Kong",
  "aliases": [
    "TA-Q-BIN HK",
    "Yamato Logistics (HK) Ltd.",
    "Yamato Logistics Hong Kong",
    "Yamato HK",
    "雅瑪多運輸(香港)有限公司",
    "雅瑪多運輸",
    "香港宅急便",
    "宅急便 (香港)"
  ],
  "region": {
    "countries": [
      "HK"
    ]
  },
  "brand": {
    "color": "#fdd000"
  },
  "selectable": true,
  "timezone": "Asia/Hong_Kong",
  "tracking": {
    "mode": "automatic",
    "adapter": "taqbin-hk",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://app01.yamatohk.com.hk/spds-track-and-trace/TrackAndTrace?trackingNo={trackingNumber}",
    "searchUrl": "https://www.yamatohk.com.hk/",
    "canaryUrl": "https://www.yamatohk.com.hk/",
    "shows": [
      "status",
      "history",
      "location",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "provider_code",
      "offset_timestamps",
      "delivery_partner",
      "delivery_tracking_number",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": [
        "app01.yamatohk.com.hk"
      ],
      "pathPattern": "^/spds-track-and-trace/TrackAndTrace/?$",
      "params": [
        "trackingNo"
      ]
    },
    {
      "domains": [
        "pms.yamatohk.com.hk"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "track"
      ]
    },
    {
      "domains": [
        "delivery.message.sg"
      ],
      "pathPattern": "^/YTHKtracking/?$",
      "params": [
        "a"
      ]
    }
  ],
  "detection": []
}
