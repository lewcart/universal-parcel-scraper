{
  "id": "tmm-express",
  "displayName": "TMM Express",
  "aliases": [
    "ТММ Express"
  ],
  "region": {
    "countries": [
      "UA",
      "PL",
      "LU",
      "BY"
    ]
  },
  "brand": {
    "color": "#650360"
  },
  "selectable": true,
  "timezone": "Europe/Kyiv",
  "tracking": {
    "mode": "automatic",
    "adapter": "tmm-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 837
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country"
  ],
  "portal": {
    "url": "https://ukr.tmm-express.com/en/trackparcels?num={trackingNumber}&mark=is_code",
    "searchUrl": "https://ukr.tmm-express.com/en/callback",
    "canaryUrl": "https://ukr.tmm-express.com/en/callback",
    "shows": [
      "status",
      "history",
      "location",
      "departure_date",
      "origin",
      "destination",
      "delivered_at",
      "delivery_tracking_number",
      "signatory",
      "recipient_address",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country"
    ],
    "discarded": [
      "departure_date",
      "origin",
      "destination",
      "delivered_at",
      "delivery_tracking_number",
      "signatory",
      "recipient_address",
      "remarks"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "offset_timestamps",
      "delivery_partner",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "tmm-express.com"
      ],
      "pathPattern": "^/(?:en|ru|uk|pl)/trackparcels/?$",
      "params": [
        "num"
      ]
    }
  ],
  "detection": []
}
