{
  "id": "toyou",
  "displayName": "toyou",
  "aliases": [
    "toYou by ASDA",
    "Asda toyou",
    "Asda ToYou"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#007481"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "toyou",
    "steps": [
      "trawl"
    ],
    "browser": true,
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://www.toyou.co.uk/track/{trackingNumber}",
    "searchUrl": "https://www.toyou.co.uk/track",
    "canaryUrl": "https://www.toyou.co.uk/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "location",
      "weight",
      "service_name",
      "provider_code",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.toyou.co.uk",
        "toyou.co.uk"
      ],
      "path": "^/track/([A-Za-z0-9]+)/?$"
    }
  ],
  "detection": []
}
