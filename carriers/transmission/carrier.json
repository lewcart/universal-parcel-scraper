{
  "id": "transmission",
  "displayName": "TransMission",
  "aliases": [
    "TransMission B.V."
  ],
  "region": {
    "countries": [
      "NL",
      "BE",
      "LU"
    ]
  },
  "brand": {
    "color": "#e32314"
  },
  "selectable": true,
  "timezone": "Europe/Amsterdam",
  "tracking": {
    "mode": "automatic",
    "adapter": "transmission",
