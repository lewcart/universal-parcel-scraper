{
  "id": "trendyol-express",
  "displayName": "Trendyol Express",
  "aliases": [
    "Trendyol Ekspres",
    "TEX",
    "Trendyol Express Kargo"
  ],
  "region": {
    "countries": [
      "TR"
    ]
  },
  "brand": {
    "color": "#f16623"
  },
  "selectable": true,
  "timezone": "Europe/Istanbul",
  "tracking": {
    "mode": "automatic",
    "adapter": "trendyol-express",
    "steps": [
      "trawl"
    ],
    "browser": true,
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://kargotakip.trendyol.com/?orderNumber={trackingNumber}",
    "searchUrl": "https://trendyolexpress.com/",
    "canaryUrl": "https://trendyolexpress.com/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "eta",
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "kargotakip.trendyol.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "orderNumber"
      ]
    }
  ],
  "detection": []
}
