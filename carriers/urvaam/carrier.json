{
  "id": "urvaam",
  "displayName": "Urvaam",
  "aliases": [
    "URVAAM",
    "Servicios Urbanos Vaam"
  ],
  "region": {
    "countries": [
      "ES"
    ]
  },
  "brand": {
    "color": "#e84417"
  },
  "selectable": true,
  "timezone": "Europe/Madrid",
  "tracking": {
    "mode": "automatic",
    "adapter": "urvaam",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 848
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "pickup_point"
  ],
  "portal": {
    "url": "https://www.urvaam.es/track/result?no={trackingNumber}",
    "searchUrl": "https://www.urvaam.es/track",
    "canaryUrl": "https://www.urvaam.es/track",
    "shows": [
      "status",
      "history",
      "location",
      "customer_reference",
      "proof_of_delivery",
      "pickup_point",
      "pickup_point_address",
      "office_opening_hours"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "pickup_point",
      "pickup_point_address"
    ],
    "discarded": [
      "customer_reference",
      "proof_of_delivery",
      "office_opening_hours"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "www.urvaam.es",
        "urvaam.es"
      ],
      "pathPattern": "^/track/result/?$",
      "params": [
        "no"
      ]
    }
  ],
  "detection": []
}
