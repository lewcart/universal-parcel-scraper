{
  "id": "vasp-expresso",
  "displayName": "Vasp Expresso",
  "aliases": [
    "VASP Expresso",
    "Vasp",
    "VASP"
  ],
  "region": {
    "countries": [
      "PT"
    ]
  },
  "brand": {
    "color": "#02518a"
  },
  "selectable": true,
  "timezone": "Europe/Lisbon",
  "tracking": {
    "mode": "automatic",
    "adapter": "vasp-expresso",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 885
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://www.vaspexpresso.pt/pt/geral/track-and-trace/?search={trackingNumber}",
    "searchUrl": "https://www.vaspexpresso.pt/pt/geral/track-and-trace/",
    "canaryUrl": "https://www.vaspexpresso.pt/pt/geral/track-and-trace/",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail",
      "parcel_count",
      "eta",
      "customer_reference",
      "proof_of_delivery",
      "canonical_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "canonical_tracking_number"
    ],
    "discarded": [
      "progress_rail",
      "parcel_count",
      "eta",
      "customer_reference",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "delivered_at",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "vaspexpresso.pt"
      ],
      "pathPattern": "^/pt/geral/track-and-trace/?$",
      "params": [
        "search"
      ]
    }
  ],
  "detection": []
}
