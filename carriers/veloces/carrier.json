{
  "id": "veloces",
  "displayName": "Veloces",
  "aliases": [],
  "region": {
    "countries": [
      "CO",
      "MX",
      "EC",
      "CL"
    ]
  },
  "brand": {
    "color": "#fd026f"
  },
  "selectable": true,
  "timezone": "America/Bogota",
  "tracking": {
    "mode": "automatic",
    "adapter": "veloces",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://tracking.veloces.app/tracking-client/{trackingNumber}",
    "searchUrl": "https://tracking.veloces.app/",
    "canaryUrl": "https://tracking.veloces.app/",
    "shows": [
      "status",
      "history",
      "delivered_at",
      "failed_delivery_reason",
      "remarks",
      "proof_of_delivery",
      "notices",
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "contact_details",
      "coordinates",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivered_at",
      "offset_timestamps",
      "failed_delivery_reason"
    ],
    "discarded": [
      "remarks",
      "proof_of_delivery",
      "notices",
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "contact_details",
      "coordinates",
      "payment_details"
    ],
    "unavailable": [
      "location",
      "eta",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.veloces.app"
      ],
      "path": "^/tracking-client/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
