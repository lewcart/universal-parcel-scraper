        "vrlgroup.in",
        "www.vrlgroup.in"
      ],
      "pathPattern": "^/(tc|track_consignment)\\.aspx$",
      "params": [
        "lrno"
      ]
    },
    {
      "domains": [
        "vrlgroup.in",
        "www.vrlgroup.in"
      ],
      "pathPattern": "^/search_vrl_consignment_number\\.aspx$",
