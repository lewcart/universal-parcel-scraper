{
  "id": "whistl",
  "displayName": "Whistl",
  "aliases": [
    "Whistl UK",
    "TNT Post UK",
    "Parcelhub",
    "Whistl Despatch"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#fd4f00"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "whistl",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 320
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "service_name",
    "delivery_partner",
    "delivery_tracking_number",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://web.parcelhub.net/Tracking/reference/{trackingNumber}",
    "searchUrl": "https://web.parcelhub.net/Tracking",
    "canaryUrl": "https://web.parcelhub.net/Tracking",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "delivery_partner",
      "delivery_tracking_number",
      "sender_reference",
      "recipient_reference"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "sender_reference",
      "recipient_reference",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight",
      "sender_name",
      "recipient_name",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "web.parcelhub.net",
        "despatch.whistl.co.uk"
      ],
      "path": "^/Tracking/reference/([^/?#]+)(?:/postcode/[^/?#]*)?/?$"
    },
    {
      "domains": [
        "trackmyitem.whistl.co.uk"
      ],
      "path": "^/tracking/([^/?#]+)/?$"
    }
  ],
  "detection": [
    { "id": "whistl-1", "pattern": "^L\\d{17}$", "confidence": "low" }
  ]
}
