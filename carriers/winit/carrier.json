{
  "id": "winit",
  "displayName": "WINIT",
  "aliases": [
    "万邑通",
    "万邑通（上海）信息科技股份有限公司",
    "WINIT Information Technology Co., Ltd.",
    "WINIT Corporation"
  ],
  "region": {
    "countries": [
      "CN",
      "US",
      "CA",
      "GB",
      "DE",
      "AU"
    ]
  },
  "brand": {
    "color": "#a07647"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "winit",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 855
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "offset_timestamps",
    "provider_code",
    "eta",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number",
    "delivered_at"
  ],
  "portal": {
    "url": "https://track.winit.com/tracking/Mobile/result?trackingNos={trackingNumber}",
    "searchUrl": "https://track.winit.com/tracking/Mobile",
    "canaryUrl": "https://track.winit.com/tracking/Mobile",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "delivered_at",
      "tracking_alias"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "eta",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "delivered_at"
    ],
    "discarded": [
      "tracking_alias"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "track.winit.com",
        "track.winit.com.cn"
      ],
      "pathPattern": "^/tracking/Mobile/result/?$",
      "params": [
        "trackingNos"
      ]
    },
    {
      "domains": [
        "track.winit.com",
        "track.winit.com.cn"
      ],
      "path": "^/tracking/Index/result(?:/l/[a-z-]+)?/trackingNoString/([^/?#]+)(?:/l/[a-z-]+)?/?$"
    },
    {
      "domains": [
        "track.winit.com",
        "track.winit.com.cn"
      ],
      "path": "^/tracking/Mobile/traceDetail/trackingNo/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "winit-1",
      "pattern": "^ID\\d{14}[A-Z]{2}$",
      "confidence": "high"
    },
    {
      "id": "winit-2",
      "pattern": "^WO\\d{11}(?:\\d{3})?[A-Z]{2}$",
      "confidence": "high"
    },
    {
      "id": "winit-3",
      "pattern": "^WO\\d{10,11}[A-Z]$",
      "confidence": "high"
    }
  ]
}
