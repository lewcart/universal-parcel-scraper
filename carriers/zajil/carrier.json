{
  "id": "zajil",
  "displayName": "Zajil Express",
  "aliases": [
    "Zajil",
    "Zajil Express Company",
    "زاجل",
    "شركة زاجل"
  ],
  "region": {
    "countries": [
      "SA"
    ]
  },
  "brand": {
    "color": "#ffc20e"
  },
  "selectable": true,
  "timezone": "Asia/Riyadh",
  "tracking": {
    "mode": "automatic",
    "adapter": "zajil",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "location",
    "provider_code",
    "destination_country"
  ],
  "portal": {
    "url": "https://zajil-express.com/track?tracking_id={trackingNumber}",
    "searchUrl": "https://zajil-express.com/track",
    "canaryUrl": "https://zajil-express.com/track",
    "shows": [
      "status",
      "progress_rail",
      "scan_times",
      "awb_date",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "scan_times",
      "location",
      "provider_code",
      "destination_country"
    ],
    "discarded": [
      "progress_rail",
      "awb_date",
      "origin",
      "destination"
    ],
    "unavailable": [
      "history",
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "zajil-express.com"
      ],
      "pathPattern": "^/(?:ar/)?track/?$",
      "params": [
        "tracking_id"
      ]
    }
  ],
  "detection": []
}
