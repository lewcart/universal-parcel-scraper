{
  "id": "zr-express",
  "displayName": "ZR Express",
  "aliases": [
    "ZR Express Algérie",
    "ZRexpress"
  ],
  "region": {
    "countries": [
      "DZ"
    ]
  },
  "brand": {
    "color": "#ffcb05"
  },
  "selectable": true,
  "timezone": "Africa/Algiers",
  "tracking": {
    "mode": "automatic",
    "adapter": "zr-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 801
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivered_at"
  ],
  "portal": {
    "url": "https://www.zrexpress.net/suivi?tn={trackingNumber}",
    "searchUrl": "https://www.zrexpress.net/suivi",
    "canaryUrl": "https://www.zrexpress.net/suivi",
    "shows": [
      "status",
      "history",
      "location",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "offset_timestamps",
      "delivered_at"
    ],
    "discarded": [
      "remarks"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "pickup_point",
      "sender_name",
      "recipient_name",
      "destination_country",
      "proof_of_delivery",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "www.zrexpress.net",
        "zrexpress.net",
        "zrexpress.dz",
        "www.zrexpress.dz"
      ],
      "pathPattern": "^/(?:suivi|en/track|ar/suivi)/?$",
      "params": [
        "tn"
      ]
    }
  ],
  "detection": [
    {
      "id": "zr-express-1",
      "pattern": "^\\d{2}[A-Z0-9]{6}(?:[A-Z0-9]|[A-Z0-9]{4})?ZR$",
      "rawPattern": "^\\d{2}-[A-Z0-9]{6}(?:[A-Z0-9]|[A-Z0-9]{4})?-ZR$",
      "confidence": "high"
    }
  ]
}
